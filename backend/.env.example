# Benji license + Airwallex API
PORT=8787
PUBLIC_BASE_URL=http://localhost:5173

# Airwallex (sandbox by default)
# Get keys: https://www.airwallex.com/app/ → Settings → Developer → API keys
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_BASE=https://api-demo.airwallex.com/api/v1
AIRWALLEX_WEBHOOK_SECRET=

# Use mock checkout locally without Airwallex credentials
AIRWALLEX_MOCK=true

# Production example:
# AIRWALLEX_API_BASE=https://api.airwallex.com/api/v1
# AIRWALLEX_MOCK=false
# PUBLIC_BASE_URL=https://benjisaiempire.com
